% All in preamble:

\usepackage{listings}

\usepackage{minted}

\usepackage[skins,minted]{tcolorbox}
\definecolor{mintedbackground}{rgb}{1,1,1}
\definecolor{mintedframe}{rgb}{1,1,1}
\definecolor{mintedborder}{rgb}{0.70,0.85,0.95}

\setminted{
    bgcolor=mintedbackground,
    frame=none,
    fontsize=\footnotesize,
    linenos,
    numbersep=5pt,
    xleftmargin=5pt,
    escapeinside=||,
    mathescape=true,
}

\newtcblisting{fileminted}[3][]{enhanced, 
    listing engine=minted,
    listing only, 
    #1, 
    title=#2, 
    minted language=#3,
    coltitle=mintedbackground!30!black,
    fonttitle=\ttfamily\footnotesize,
    sharp corners, 
    boxrule=0pt, 
    colframe=mintedbackground,
    top=0mm, 
    bottom=-7mm, 
    left=0pt, 
    right=0pt, 
    boxsep=3pt,
    colback=mintedbackground,
    title code={
        \path[draw=mintedborder,dashed](title.south west)--(title.south east);
        \path[draw=mintedborder,dashed](title.north west)--(title.north east);
    },
    frame code={
        \path[draw=mintedframe, fill=mintedbackground](frame.south west) rectangle (frame.north east);
        \path[draw=mintedborder,dashed](frame.south west)--(frame.south east);
    },
}

\newtcblisting{mathalgo}[2][]{
    enhanced,
    listing engine=minted,
    listing only,
    #1,
    title=#2,
    minted language=python,
    coltitle=black, % Make the title text black
    fonttitle=\normalfont\footnotesize, % Normal text family for title
    sharp corners,
    boxrule=1pt, % Ensure visible box rule
    colframe=black, % Black frame color
    top=0mm,
    bottom=0mm,
    left=0pt,
    right=0pt,
    boxsep=3pt,
    colback=white, % White background to remove highlighting
    minted style=bw, % Black & white style for minted (removes colors)
    % minted options={texcl=true, gobble=0}, % Allow math escaping
    title code={
        \path[draw=black](title.south west)--(title.south east);
        \path[draw=black](title.north west)--(title.north east);
    },
    frame code={
        \path[draw=black, fill=white](frame.south west) rectangle (frame.north east);
        \path[draw=black](frame.south west)--(frame.south east);
    },
}



\lstset{frame=tb,
  language=Python,
  % aboveskip=1mm,
  % belowskip=1mm,
  showstringspaces=false,
  columns=flexible,
  basicstyle={\small\upshape},
  numbers=left,
  numbersep=-5pt,
  keywordstyle=\color{black}\bfseries,
  breaklines=true,
  breakatwhitespace=true,
  mathescape=true,
  tabsize=2
}